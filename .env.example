APP_NAME=fastapi-users-service
APP_ENV=local
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-local-db-password
DB_NAME=fastapi_app

SQL_ECHO=true
CREATE_DB_TABLES=false

STATIC_DIR=static
