APP_NAME=fastapi-users-service
APP_ENV=test
API_V1_PREFIX=/api/v1

SECRET_KEY=change-me-test-secret-key-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=fastapi_app_test
DATABASE_URL=sqlite:///./test.db

SQL_ECHO=false
CREATE_DB_TABLES=true
STATIC_DIR=static
LOG_DIR=logs
