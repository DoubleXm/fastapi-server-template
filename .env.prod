APP_NAME=fastapi-users-service
APP_ENV=production
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-production-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

BACKEND_CORS_ORIGINS=https://your-frontend.example.com
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

DB_HOST=mysql
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=replace-with-production-db-password
DB_NAME=fastapi_app

SQL_ECHO=false
CREATE_DB_TABLES=false
STATIC_DIR=static
LOG_DIR=logs
